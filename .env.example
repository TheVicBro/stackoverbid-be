# Copy to .env and set your values. Do not commit .env.

# JWT signing key (required in production; use a long random string)
SECRET_KEY=your-secret-key-here
FRONTEND_URL=the-frontend-url

# Optional: override database URL (default: sqlite:///./stackoverbid.db)
# For local SQLite:       DATABASE_URL=sqlite:///./stackoverbid.db
# For remote PostgreSQL:  DATABASE_URL=postgresql://user:password@hostname/dbname

# Optional: Gemini (free tier API key) for listing tag suggestions — otherwise keyword rules are used
# https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_TAG_MODEL=gemini-2.5-flash  # default; gemini-3.1-flash-lite-preview also works (preview tier)
